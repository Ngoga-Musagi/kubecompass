# Copy to .env and adjust. Never commit .env.

# --- Elasticsearch ---
KUBECOMPASS_ES_URL=http://localhost:9200
# KUBECOMPASS_ES_API_KEY=            # for Elastic Cloud / secured clusters
ES_VERSION=9.4.8

# --- Embeddings (local, no key needed) ---
KUBECOMPASS_EMBEDDING_PROVIDER=fastembed   # fastembed | none (keyword-only)
KUBECOMPASS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- LLM (optional; the app works without it) ---
# Comma list in priority order; the next provider is used if one fails (bad key, no credits,
# offline). "auto" = anthropic → openai → ollama, using those with a key / a running server.
KUBECOMPASS_LLM_PROVIDER=auto
# Anthropic
# ANTHROPIC_API_KEY=
KUBECOMPASS_ANTHROPIC_MODEL=claude-opus-5-5
# OpenAI (or any OpenAI-compatible endpoint via KUBECOMPASS_OPENAI_BASE_URL)
# OPENAI_API_KEY=
KUBECOMPASS_OPENAI_MODEL=gpt-5.4-mini
KUBECOMPASS_OPENAI_REASONING_EFFORT=low     # leave empty for non-reasoning models (e.g. gpt-4o-mini)
# Local models via Ollama (https://ollama.com): `ollama pull qwen3.5:4b-q4_K_M`
KUBECOMPASS_OLLAMA_BASE_URL=http://localhost:11434/v1
KUBECOMPASS_OLLAMA_MODEL=qwen3.5:4b-q4_K_M  # also works: qwen2.5:3b, qwen3-vl:4b-instruct
KUBECOMPASS_OLLAMA_REASONING_EFFORT=none    # Qwen 3.5 "thinks" for minutes without this

# --- Search ---
KUBECOMPASS_FUSION_MODE=app                # app | native

# --- Admin / safety ---
# KUBECOMPASS_ADMIN_TOKEN=change-me        # required for /api/admin/*; unset = disabled
# Turns an email/username into a personal attendee id (HMAC). Set a long random value in any
# shared deployment and keep it stable. Unset = a fixed development secret.
# KUBECOMPASS_IDENTITY_SECRET=
KUBECOMPASS_RATE_LIMIT_PER_MINUTE=30

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
