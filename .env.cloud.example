# Elastic Cloud Serverless profile. Copy to .env.cloud, fill in, then run commands with
#   KUBECOMPASS_ENV_FILE=.env.cloud   (see docs/ELASTIC_CLOUD.md). Never commit .env.cloud.
KUBECOMPASS_ES_URL=https://<your-project>.es.<region>.elastic.cloud:443
KUBECOMPASS_ES_API_KEY=<encoded API key>
KUBECOMPASS_KIBANA_URL=https://<your-project>.kb.<region>.elastic.cloud
# Jina embeddings on the Elastic Inference Service (1024-d). Re-ingest after switching models.
KUBECOMPASS_EMBEDDING_PROVIDER=elastic
KUBECOMPASS_ELASTIC_EMBEDDING_INFERENCE_ID=.jina-embeddings-v3
KUBECOMPASS_EMBEDDING_DIMENSIONS=1024
# Native semantic_text field (for Agent Builder / Workflows semantic queries)
KUBECOMPASS_SEMANTIC_TEXT_INFERENCE_ID=.jina-embeddings-v3
KUBECOMPASS_LLM_PROVIDER=auto
